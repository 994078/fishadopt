<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络访问：实际使用者为容器内 DSH（见关于页说明），外壳本身不上传任何数据 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 所有文件访问：在应用私有目录存放 RootFS、导出日志文件（PRD 表7，必需） -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- 前台服务：维持容器进程存活、展示运行状态通知（PRD 表7，必需） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 通知：发布常驻通知与异常提醒（PRD 表7，必需） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 可选：用户从外部导入文件给 Agent 处理 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- 电池优化白名单请求（引导用户关闭，非强制） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".FishApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.FishAdopt"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.FishAdopt">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          前台服务。foregroundServiceType 使用 specialUse（Android 14+ 对非标准长驻任务强制要求），
          PROPERTY_SPECIAL_USE_FGS_SUBTYPE 描述用途：托管 PRoot 容器内运行的 DSH 服务。
        -->
        <service
            android:name=".service.FishForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="托管 PRoot 容器内的 DeepSeek Harness 服务，维持其在前台运行并展示状态通知" />
        </service>
    </application>
</manifest>
